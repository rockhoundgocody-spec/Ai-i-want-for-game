# Local development only. Copy to .env.local (git-ignored).
#
# WARNING: this value is inlined into the JavaScript that the dev server serves.
# A production build with it set is refused (see vite.config.ts) because the key
# would be public: anyone could read it from the page and spend your quota.
# Call Gemini from a server you control instead; see docs/ROLE_AND_PLAN.md.
GEMINI_API_KEY=
